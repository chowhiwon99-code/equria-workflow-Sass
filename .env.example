# ============================================================
# Complow Workspace — 환경변수 템플릿
# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요.
# .env.local 은 git에 커밋하지 않습니다.
# ============================================================

# Anthropic (서버사이드 전용 — 절대 NEXT_PUBLIC_ 접두사 붙이지 말 것)
ANTHROPIC_API_KEY=sk-ant-api03-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://[project-id].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # 서버사이드 전용

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Complow 워크스페이스

# 워크스페이스 공용 비밀번호 (이름 + 이 비번으로 로그인)
# 배포 환경에서는 반드시 강력한 값(12자 이상, 영문+숫자+특수문자)으로 설정
WORKSPACE_PASSWORD=changeme

# Google OAuth (Gmail·Drive 연동 — 모두 서버 전용, NEXT_PUBLIC_ 금지)
# Google Cloud Console → OAuth 클라이언트(웹 애플리케이션)에서 발급
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 승인된 리디렉션 URI와 정확히 일치해야 함(스킴/포트/경로/슬래시)
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/google/callback
# 토큰 암호화 키(AES-256-GCM) — 32바이트 base64. 생성: openssl rand -base64 32
# ⚠️ 분실 시 전 직원 Google 재연결 필요
GOOGLE_TOKEN_ENC_KEY=

# ============================================================
# 나이스페이 (결제) — 전부 서버 전용. NEXT_PUBLIC_ 접두사 절대 금지.
# 나이스페이 관리자 > 상점정보에서 발급. 심사 통과 후 상용 값으로 교체한다.
# 이 두 값이 비어 있으면 결제 화면이 "결제 준비 중"으로 잠기고, 'ready' 주문 행도 만들지 않는다.
#
# ⚠️ 2026-08-20 확정: 우리 상점(포스타트)은 REST 계열이라 **클라이언트키 + 시크릿키**를 쓴다.
#    담당자 회신 원문: "포스타트에서는 홈페이지 연동 시 MID가 아닌 클라이언트키/시크릿키
#    통하여 연동이 가능합니다." 발급 = 상점관리자 > 개발정보 > `+ 발급`(Server 승인 + Basic 인증).
#    인증 헤더는 Authorization: Basic base64(클라이언트키:시크릿키).
#    ⚠️ 시크릿키는 카드정보 암호화 키로도 쓰인다(AES-256-CBC). 절대 클라이언트로 내보내지 말 것.
#    ⚠️ 관리자의 IP보안(REST API 접근제한)은 비워둘 것 — Vercel은 아웃바운드 IP가 고정이 아니다.
# ============================================================
NICEPAY_CLIENT_KEY=
NICEPAY_SECRET_KEY=

# ============================================================
# 결제 자동 점검(크론) — Vercel 전용, 서버 전용
# ============================================================
# Vercel에 이 이름으로 환경변수를 넣으면, 크론이 우리 엔드포인트를 부를 때
# `Authorization: Bearer <값>` 헤더를 자동으로 붙여 보낸다(2026-08-19 Vercel 문서 확인).
# /api/billing/reconcile 은 이 값이 **없으면 GET을 전부 401로 막는다** → 반드시 넣을 것.
# 16자 이상 랜덤 문자열 권장. 로컬에서는 없어도 되고(크론이 안 돔), 지연 대사(POST)는 로그인으로 동작한다.
#
# ⚠️ 크론은 하루 1회로 걸려 있다(vercel.json). Vercel **Hobby 플랜은 하루 1회가 상한**이고
#    그보다 잦은 cron 식을 쓰면 **배포가 실패**한다. Pro 플랜이면 vercel.json의 schedule만
#    조이면 된다(코드 변경 없음).
CRON_SECRET=
